rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Super Admin check ─────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'noamhemo2001@gmail.com';
    }

    // ── Global admin bypass (must be first) ──────────────────────────────────
    match /{document=**} {
      allow read, write, delete: if isAdmin();
    }

    // ── Users (Authors) ──────────────────────────────────────────────────────
    // Anyone can read public profiles; only the owner can edit their own profile
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Books ─────────────────────────────────────────────────────────────────
    // Published books are readable by anyone; only the author who owns the book can write
    match /books/{bookId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // ── Orders ───────────────────────────────────────────────────────────────
    // Orders can only be read by the author of that order; creation is server-only
    match /orders/{orderId} {
      allow read: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
      // Orders are created only via server-side API (checkout route) — never from client
      allow create: if false;
      allow delete: if false;
    }

    // ── Fan Mail ─────────────────────────────────────────────────────────────
    // Authors can read their own fan mail; authenticated users can create
    match /fan_mail/{mailId} {
      allow read: if request.auth != null && resource.data.authorId == request.auth.uid;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // ── Admin Notifications ──────────────────────────────────────────────────
    // Only the admin can read or write admin notifications
    match /admin_notifications/{notifId} {
      allow read, write, delete: if isAdmin();
    }

    // ── OTP codes ────────────────────────────────────────────────────────────
    // OTPs are written and read only by Firebase Admin SDK (server-side API routes)
    // No client can directly read/write OTP documents
    match /otps/{uid} {
      allow read, write, delete: if false;
    }
  }
}

